<section class="pairs-section section-{{ section.id }}">
  {% style %}
    .section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }} .pairs-wrapper {
      text-align: center;
    }

    .section-{{ section.id }} .pairs-title {
      color: {{ section.settings.heading_color }};
      margin: 0 0 50px;
    }

    .section-{{ section.id }} .pairs-blocks {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: clamp(15px, 4.17vw, 60px);
      justify-content: space-between;
    }

    .section-{{ section.id }} .pairs-card {
        background-color: {{ section.settings.card_background_color }};
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
    }

    .section-{{ section.id }} .paies-card-icon {
        line-height: 0;
        max-height: 70px;
        height: auto;
    }

    .section-{{ section.id }} .paies-card-icon img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .section-{{ section.id }} .pairs-card-text {
        color: {{ section.settings.text_color }};
        margin: 0;
        text-align: center;
        font-family: "DM Sans";
        font-size: 18px;
        font-style: normal;
        font-weight: 400;
        line-height: 22px;
        letter-spacing: 0;
        min-width: max-content;
    }

    @media screen and (max-width: 992px) {
      .section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      .section-{{ section.id }} .pairs-blocks {
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      }

      .section-{{ section.id }} .pairs-title {
        margin-bottom: 24px;
      }

      .section-{{ section.id }} .paies-card-icon {
        height: 60px;
    }

    .section-{{ section.id }} .pairs-card-text {
        font-size: 14px;
    }

    }
  {% endstyle %}

  <div class="page-width">
    <div class="pairs-wrapper">

      {% if section.settings.heading != blank %}
        <h2 class="pairs-title title_title">
          {{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}
        </h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="pairs-blocks">
          {% for block in section.blocks %}
            <div
              class="pairs-card"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.icon != blank %}
                <div class="paies-card-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 1600
                    | image_tag:
                      widths: '50,100,150,200,300,400,500,600,800,1000,1200,1400,1600',
                      loading: 'lazy',
                      alt: block.settings.text
                  }}
                </div>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="pairs-card-text">
                  {{ block.settings.text }}
                </p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pairs Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card Background",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 1,
      "max": 9,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Pair Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Card text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pairs Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "pair"
        },
        {
          "type": "pair"
        },
        {
          "type": "pair"
        },
        {
          "type": "pair"
        }
      ]
    }
  ]
}
{% endschema %}