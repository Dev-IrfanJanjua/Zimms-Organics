{% style %}
.section-{{ section.id }} {
  background-color: {{ section.settings.section_bg_color }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .principles-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 34px;
}

.section-{{ section.id }} .principles-tag {
    color: {{ section.settings.tag_color }};
    margin: 0 0 12px;
    text-align: center;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0;
}

.section-{{ section.id }} .principles-title {
  color: {{ section.settings.heading_color }};
}

.section-{{ section.id }} .principles-subtitle {
    color: {{ section.settings.text_color }};
    margin: 0 auto;
    max-width: 730px;
    text-align: center;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
}

.section-{{ section.id }} .principles-block {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.section-{{ section.id }} .principles-block-item {
    background-color: {{ section.settings.card_bg_color }};
    padding: 32px;
    border-radius: 8px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.section-{{ section.id }} .principles-block__icon {
    max-width: 50px;
    width: 100%;
    height: 50px;
    flex-shrink: 0;
}

.section-{{ section.id }} .principles-block__icon img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.section-{{ section.id }} .principles-block__title {
    color: {{ section.settings.card_heading_color }};
    font-family: Lora;
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 32px;
    margin: 0;
}

.section-{{ section.id }} .principles-block__subtitle {
    color: {{ section.settings.card_text_color }};
    margin: 0;
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 26px;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .principles-head {
    margin-bottom: 24px;
  }

    .section-{{ section.id }} .principles-subtitle {
        max-width: 100%;
        font-size: 14px;
    }

  .section-{{ section.id }} .principles-block {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .section-{{ section.id }} .principles-block-item {
    padding: 16px;
    gap: 12px;
  }

    .section-{{ section.id }} .principles-block__title {
        font-size: 18px;
        line-height: 26px;
    }

    .section-{{ section.id }} .principles-block__subtitle {
        color: #1a2744;
        margin: 0;
        font-family: "DM Sans";
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: 22px;
    }

    .section-{{ section.id }} .principles-tag{
        margin: 0;
    }

}
{% endstyle %}

<section class="principles-section section-{{ section.id }} scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="principles-wrapper">

      {% if section.settings.tag != blank or section.settings.heading != blank or section.settings.subtitle != blank %}
        <div class="principles-head">

          {% if section.settings.tag != blank %}
            <p class="principles-tag tag_tag">
              {{ section.settings.tag }}
            </p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="principles-title title_title">
              {{ section.settings.heading
                | replace: '<p>', ''
                | replace: '</p>', ''
              }}
            </h2>
          {% endif %}

          {% if section.settings.subtitle != blank %}
            <div class="principles-subtitle">
              {{ section.settings.subtitle }}
            </div>
          {% endif %}

        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="principles-block">
          {% for block in section.blocks %}
            <li
              class="principles-block-item scroll-trigger animate--slide-in"
              {{ block.shopify_attributes }}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            >

              {% if block.settings.icon != blank %}
                <div class="principles-block__icon">
                  {{
                    block.settings.icon
                    | image_url: width: 200
                    | image_tag:
                      widths: '50,100,150,200',
                      loading: 'lazy',
                      alt: 'icon'
                  }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h4 class="principles-block__title">
                  {{ block.settings.title }}
                </h4>
              {% endif %}

              {% if block.settings.subtitle != blank %}
                <div class="principles-block__subtitle">
                  {{ block.settings.subtitle }}
                </div>
              {% endif %}

            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Principles Section",
  "tag": "section",
  "class": "principles-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Principles Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "principle"
        },
        {
          "type": "principle"
        },
        {
          "type": "principle"
        }
      ]
    }
  ]
}
{% endschema %}