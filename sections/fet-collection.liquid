{% style %}
.section-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}



.fet-col-head {
    text-align: center;
    margin-bottom: 50px;
}

p.fet-col-subtitle {
    color: var(--Deep-Navy, #1A2744);
    text-align: center;
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 22px;
    margin: 16px 0 0;
}

.fet-view-all {
    margin-top: 50px;
    text-align: center;
}

.fet-view-all a.btn_btn {
    background: #1A2744;
    color: rgba(255, 255, 255, 0.99);
    max-width: 200px;
    width: 100%;
}



.fet-col-pagination{
    display: none;
}

@media screen and (max-width: 768px){

.section-{{ section.id }}{
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
}

.fet-view-all {
    display: none;
}

h2.fet-col-title.title_title {
    max-width: 307px;
    margin: 0 auto;
}

p.fet-col-subtitle {
    margin: 8px 0 0;
    letter-spacing: normal;
}

.fet-col-head {
    margin-bottom: 24px;
    padding-right: 16px;
}

.section-{{ section.id }} .page-width {
    padding-right: 0;
}



.fet-col-pagination {
    display: block;
    position: static;
    margin: 0;
    padding: 0;
    margin-top: 24px;
    padding-right: 16px;
}

.fet-col-pagination span.swiper-pagination-bullet {
    border: 1px solid var(--Deep-Navy, #1A2744);
    background: transparent;
    opacity: 1;
}

.fet-col-pagination span.swiper-pagination-bullet.swiper-pagination-bullet-active {
    max-width: 20px;
    width: 100%;
    border-radius: 10px;
    background: #1A2744;
}

}

{% endstyle %}

<section class="fet-collection-section fet-collection-section-{{ section.id }} section-{{ section.id }} scroll-trigger animate--slide-in">
  <div class="page-width">

    <div class="fet-collection-wrapper">
        <!-- Heading -->
        <div class="fet-col-head">
          <h2 class="fet-col-title title_title">{{ section.settings.title }}</h2>
          <p class="fet-col-subtitle">{{ section.settings.subtitle }}</p>
        </div>
    
        <!-- Swiper -->
        <div class="swiper fet-swiper-{{ section.id }}">
          <div class="swiper-wrapper">
    
            {% if section.settings.collection != blank %}
              {% for product in section.settings.collection.products limit: section.settings.products_limit %}
                <div class="swiper-slide">

                  {% render 'collection-card', section: section, product: product %}
    
                </div>
              {% endfor %}
            {% endif %}
    
          </div>
          <div class="swiper-pagination fet-col-pagination"></div>
        </div>
    
        <!-- View All -->
        {% if section.settings.collection != blank %}
          <div class="fet-view-all">
            <a href="{{ section.settings.collection.url }}" class="btn_btn">
              {{ section.settings.view_all_text }}
            </a>
          </div>
        {% endif %}
    </div>

  </div>
</section>

<!-- Swiper Init -->
<script>
document.addEventListener('DOMContentLoaded', function () {

  const el = document.querySelector('.fet-swiper-{{ section.id }}');
  if (!el) return;

  new Swiper(el, {
    slidesPerView: 1.1,
    spaceBetween: 12,

    breakpoints: {
      990: { slidesPerView: 3 },
      spaceBetween: 24
    },

    loop: true,
    speed: 1000,

    pagination: {
      el: '.fet-col-pagination',
      clickable: true,
    }
  });

});
</script>

{% schema %}
{
  "name": "Collection Swiper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Best picks for you"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Limit",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Media Background",
      "default": "#f5f5f5"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Featured Collection Swiper",
      "category": "Custom"
    }
  ]
}
{% endschema %}