{% comment %}
  Section: Bundle Banner
  A full-width promotional banner with product image, headline, and CTA button.
  All settings are configurable via the schema.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@600&family=DM+Sans:wght@700&display=swap" rel="stylesheet">

{%- liquid
  assign section_id = 'bundle-banner-' | append: section.id
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign btn_bg = section.settings.button_background_color
  assign btn_text = section.settings.button_text_color
  assign btn_hover_bg = section.settings.button_hover_background_color
  assign btn_hover_text = section.settings.button_hover_text_color
  assign v_align = section.settings.vertical_alignment
  assign img_mobile_pos = section.settings.image_mobile_position
-%}

<style>
  #{{ section_id }} {
    background-color: {{ bg_color }};
    padding: {{ section.settings.section_padding_vertical }}px {{ section.settings.section_padding_horizontal }}px;
  }

  #{{ section_id }} .bundle-banner__inner {
    display: flex;
    flex-direction: row;
    align-items: {% if v_align == 'top' %}flex-start{% elsif v_align == 'bottom' %}flex-end{% else %}center{% endif %};
    justify-content: space-between;
    gap: 32px;
    margin: 0 auto;
    width: 100%;
    background: #f3f3ec;
    padding: 28px 55px;
    border-radius: 4px;
  }

  #{{ section_id }} .bundle-banner__image-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: {% if v_align == 'top' %}flex-start{% elsif v_align == 'bottom' %}flex-end{% else %}center{% endif %};
  }

  #{{ section_id }} .bundle-banner__image-wrap img {
    display: block;
    width: {{ section.settings.image_width }}px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  #{{ section_id }} .bundle-banner__content {
    flex: 1;
    display: flex;
    align-items: {% if v_align == 'top' %}flex-start{% elsif v_align == 'bottom' %}flex-end{% else %}center{% endif %};
    justify-content: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    text-align: {{ section.settings.text_alignment }};
  }

  #{{ section_id }} .bundle-banner__heading {
    font-family: 'Lora', Georgia, serif;
    font-weight: 600;
    font-style: normal;
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }}px;
    letter-spacing: -0.02em;
    color: {{ text_color }};
    margin: 0;
    padding: 0;
  }

  #{{ section_id }} .bundle-banner__cta-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: {% if v_align == 'top' %}flex-start{% elsif v_align == 'bottom' %}flex-end{% else %}center{% endif %};
    justify-content: flex-end;
  }

  #{{ section_id }} .bundle-banner__btn {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: {{ section.settings.button_font_size }}px;
    line-height: 21.2px;
    letter-spacing: 0.02em;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
    color: {{ btn_text }};
    background-color: {{ btn_bg }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
    border-radius: {{ section.settings.button_border_radius }}px;
  }

  #{{ section_id }} .bundle-banner__btn:hover {
    background-color: {{ btn_hover_bg }};
    color: {{ btn_hover_text }};
    border-color: {{ section.settings.button_hover_border_color }};
  }

  /* ── Mobile ── */
  @media screen and (max-width: 767px) {
    #{{ section_id }} {
      padding: {{ section.settings.section_padding_vertical_mobile }}px {{ section.settings.section_padding_horizontal_mobile }}px;
    }

    #{{ section_id }} .bundle-banner__inner {
      flex-direction: column;
      align-items: {% if section.settings.mobile_alignment == 'left' %}flex-start{% elsif section.settings.mobile_alignment == 'right' %}flex-end{% else %}center{% endif %};
      text-align: {{ section.settings.mobile_alignment }};
      gap: {{ section.settings.mobile_gap }}px;
      padding: 28px 16px;
    }

    #{{ section_id }} .bundle-banner__image-wrap {
      order: {% if img_mobile_pos == 'bottom' %}3{% else %}1{% endif %};
      width: 100%;
      justify-content: {% if section.settings.mobile_alignment == 'left' %}flex-start{% elsif section.settings.mobile_alignment == 'right' %}flex-end{% else %}center{% endif %};
    }

    #{{ section_id }} .bundle-banner__image-wrap img {
      width: {{ section.settings.image_width_mobile }}px;
      max-width: 100%;
    }

    #{{ section_id }} .bundle-banner__content {
      order: 2;
      justify-content: {% if section.settings.mobile_alignment == 'left' %}flex-start{% elsif section.settings.mobile_alignment == 'right' %}flex-end{% else %}center{% endif %};
      text-align: {{ section.settings.mobile_alignment }};
      width: 100%;
    }

    #{{ section_id }} .bundle-banner__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
      line-height: {{ section.settings.heading_line_height_mobile }}px;
    }

    #{{ section_id }} .bundle-banner__cta-wrap {
      order: {% if img_mobile_pos == 'bottom' %}2{% else %}3{% endif %};
      width: 100%;
      justify-content: {% if section.settings.mobile_alignment == 'left' %}flex-start{% elsif section.settings.mobile_alignment == 'right' %}flex-end{% else %}center{% endif %};
    }

    {% if section.settings.button_full_width_mobile %}
    #{{ section_id }} .bundle-banner__btn {
      width: 100%;
      text-align: center;
    }
    {% endif %}
  }
</style>

<section id="{{ section_id }}" class="bundle-banner scroll-trigger animate--slide-in">
    <div class="page-width">
        <div class="bundle-banner__inner">
      
          {%- if section.settings.image != blank -%}
            <div class="bundle-banner__image-wrap">
              {{
                section.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image.alt | default: section.settings.heading,
                  widths: '200, 300, 400, 600'
              }}
            </div>
          {%- else -%}
            <div class="bundle-banner__image-wrap">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
      
          <div class="bundle-banner__content">
            {%- if section.settings.heading != blank -%}
              <{{ section.settings.heading_tag }} class="bundle-banner__heading">
                {{ section.settings.heading }}
              </{{ section.settings.heading_tag }}>
            {%- endif -%}
          </div>
      
          {%- if section.settings.button_label != blank -%}
            <div class="bundle-banner__cta-wrap">
              <a
                href="{{ section.settings.button_link }}"
                class="bundle-banner__btn"
                {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="{{ section.settings.button_label }}"
              >
                {{ section.settings.button_label }}
              </a>
            </div>
          {%- endif -%}
      
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Bundle Banner",
  "tag": "section",
  "class": "bundle-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "top",    "label": "Top"    },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment (Desktop)",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section Padding — Desktop"
    },
    {
      "type": "range",
      "id": "section_padding_vertical",
      "label": "Vertical Padding (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Horizontal Padding (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Section Padding — Mobile"
    },
    {
      "type": "range",
      "id": "section_padding_vertical_mobile",
      "label": "Vertical Padding Mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_mobile",
      "label": "Horizontal Padding Mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#EEE9E1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width Desktop (px)",
      "min": 80,
      "max": 500,
      "step": 10,
      "default": 260
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Can't Decide What you want?"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p",  "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size Desktop (px)",
      "min": 16,
      "max": 72,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height Desktop (px)",
      "min": 16,
      "max": 96,
      "step": 1,
      "default": 36
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Build Your Own Bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size (px)",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Button Vertical Padding (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button Horizontal Padding (px)",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button Border Width (px)",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button Background",
      "default": "#1C2B4A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#1C2B4A"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Button Hover Background",
      "default": "#2E4470"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Button Hover Border Color",
      "default": "#2E4470"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "select",
      "id": "image_mobile_position",
      "label": "Image Position on Mobile",
      "options": [
        { "value": "top",    "label": "Top (above text)"    },
        { "value": "bottom", "label": "Bottom (below text)" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile Content Alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile Stack Gap (px)",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image Width Mobile (px)",
      "min": 80,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading Font Size Mobile (px)",
      "min": 14,
      "max": 56,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_line_height_mobile",
      "label": "Heading Line Height Mobile (px)",
      "min": 14,
      "max": 72,
      "step": 1,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "button_full_width_mobile",
      "label": "Full-width button on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Bundle Banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
