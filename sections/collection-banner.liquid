{% style %}
.section-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
}

.section-{{ section.id }} .collection-banner-wrapper {
  position: relative;
}

.section-{{ section.id }} .collection-banner-image {
  width: 100%;
}

.section-{{ section.id }} .collection-banner-image img {
  width: 100%;
  display: block;
  height: auto;
}

.section-{{ section.id }} .collection-banner-image-mobile {
  display: none;
}

.section-{{ section.id }} .collection-banner-title {
  color: {{ section.settings.heading_color }};
  margin: 0;
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 62px;
  line-height: 66px;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }} .collection-banner-title {
    font-size: 32px;
    line-height: normal;
    padding: 0 20px;
}

  .section-{{ section.id }} .collection-banner-image-desktop {
    display: none;
  }

  .section-{{ section.id }} .collection-banner-image-mobile {
    display: block;
  }
}
{% endstyle %}

<section class="collection-banner section-{{ section.id }}">
  {% comment %} <div class="page-width"> {% endcomment %}

    <div class="collection-banner-wrapper">

      {% if section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
        <div class="collection-banner-image">

          {% if section.settings.desktop_image != blank %}
            <div class="collection-banner-image-desktop">
              {{
                section.settings.desktop_image
                | image_url: width: 2000
                | image_tag:
                  widths: '400,600,800,1000,1200,1400,1600,1800,2000',
                  loading: 'eager',
                  alt: 'Collection banner image'
              }}
            </div>
          {% endif %}

          {% if section.settings.mobile_image != blank %}
            <div class="collection-banner-image-mobile">
              {{
                section.settings.mobile_image
                | image_url: width: 1000
                | image_tag:
                  widths: '300,400,500,600,700,800,900,1000',
                  loading: 'eager',
                  alt: 'Collection banner image'
              }}
            </div>
          {% endif %}

        </div>
      {% endif %}

      {% assign banner_title = section.settings.title %}

      {% if banner_title == blank and collection %}
        {% assign banner_title = collection.title %}
      {% endif %}

      {% if banner_title != blank %}
        <h1 class="collection-banner-title title_title">
          {{ banner_title }}
        </h1>
      {% endif %}

    </div>

  {% comment %} </div> {% endcomment %}
</section>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title",
      "info": "If empty, collection title will be used."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}