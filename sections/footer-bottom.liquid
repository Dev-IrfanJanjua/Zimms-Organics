{% style %}
  .section-{{ section.id }} {
    width: 100%;
  }

  .section-{{ section.id }} .footer-bottom-image {
    display: block;
    line-height: 0;
    height: auto;
    width: 100%;
  }

  .section-{{ section.id }} .footer-bottom-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-{{ section.id }} .desktop-image {
    display: block;
  }

  .section-{{ section.id }} .mobile-image {
    display: none !important;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }} .desktop-image {
      display: none !important;
    }

    .section-{{ section.id }} .mobile-image {
      display: block !important;
    }
  }
{% endstyle %}

<section class="footer-bottom-section section-{{ section.id }} scroll-trigger animate--slide-in">
  <div class="footer-bottom-image">

    {% if section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2000
        | image_tag:
          class: 'desktop-image',
          widths: '768,1000,1200,1600,2000',
          loading: 'lazy',
          alt: section.settings.desktop_image.alt
      }}
    {% endif %}

    {% if section.settings.mobile_image != blank %}
      {{
        section.settings.mobile_image
        | image_url: width: 750
        | image_tag:
          class: 'mobile-image',
          widths: '375,550,750',
          loading: 'lazy',
          alt: section.settings.mobile_image.alt
      }}
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Footer Bottom Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "presets": [
    {
      "name": "Footer Bottom Image",
      "category": "Custom"
    }
  ]
}
{% endschema %}