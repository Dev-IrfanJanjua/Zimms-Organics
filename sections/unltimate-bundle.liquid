{% liquid
  assign selected_product = section.settings.product
  assign display_image = section.settings.custom_image
  assign display_title = section.settings.custom_title | replace: '<p>', '' | replace: '</p>', ''

  assign product_form_id = 'product-form-' | append: section.id

  if display_image == blank and selected_product != blank
    assign display_image = selected_product.featured_image
  endif

  if display_title == blank and selected_product != blank
    assign display_title = selected_product.title
  endif

  assign compare_price = selected_product.compare_at_price
  assign price = selected_product.price

  if compare_price > price
    assign savings = compare_price | minus: price | money_without_trailing_zeros
  else
    assign savings = section.settings.total_price
  endif

%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% style %}
.section-{{ section.id }} {
    background: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .ultimate-bundle-title {
    color: {{ section.settings.heading_color }};
    font-family: Lora;
    font-size: 44px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: capitalize;
    margin: 12px 0 0;
}

.section-{{ section.id }} .ultimate-bundle-review-text {
    color: {{ section.settings.tag_color }};
    text-align: center;
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    margin: 0;
}

.section-{{ section.id }} .ultimate-bundle-block,
.section-{{ section.id }} .ultimate-bundle-saving,
.section-{{ section.id }} .ultimate-bundle_bottom {
    background: {{ section.settings.card_color }};
}

.ultimate--bundle-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
}

.ultimate-bundle-wrapper {
    display: flex;
    align-items: center;
    gap: 50px;
}

.ultimate--bundle-image {
    max-width: 50%;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
}

.unltimate-bundle-content {
    max-width: calc(100% - (50% + 50px));
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.ultimate-bundle-review {
    display: flex;
    align-items: center;
    gap: 8px;
}

.ultimate-bundle-review-icon {
    max-width: 100px;
    height: auto;
    width: 100%;
}

.ultimate-bundle-review-icon img{
    width: 100%;
    height: 100%;
    display: block;
}

.ultimate-bundle-include, 
.ultimate-bundle-saving, 
.ultimate-bundle_bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

ul.ultimate-bundle-blocks, 
ul.ultimate-bundle-saving_items {
    padding: 0;
    margin: 0;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.ultimate-bundle_bottom-feture_icon {
    width: 18px;
    height: 18px;
    display: flex;
    flex-shrink: 0;
}

.ultimate-bundle_bottom-feture_icon img{
    width: 100%;
    height: 100%;
    display: block;
}

ul.ultimate-bundle_bottom-fetures {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style-type: none;
    justify-content: center;
    gap: 23px;
}

li.ultimate-bundle_bottom-feture {
    display: flex;
    align-items: center;
    gap: 10px;
}

p.ultimate-bundle_bottom-feture_text {
    color: var(--Deep-Navy, #1A2744);
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    margin: 0;
    letter-spacing: normal;
}

h4.ultimate-bundle-include_tite,
h4.ultimate-bundle-saving_title {
    color: var(--Deep-Navy, #1A2744);
    font-family: Lora;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0.96px;
    text-transform: uppercase;
    margin: 0;
}

li.ultimate-bundle-block,
li.ultimate-bundle-saving_item,
.ultimate-bundle_bottom-info {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: space-between;
}

h3.ultimate-bundle-block_title,
p.ultimate-bundle-saving_item-text {
    color: var(--Deep-Navy, #1A2744);
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    margin: 0;
}

.ultimate-bundle-block_prices,
.ultimate-bundle_bottom-prices {
    display: flex;
    align-items: center;
    gap: 10px;
}

p.ultimate-bundle-block_price_compare {
    color: #485269;
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-decoration-line: line-through;
    margin: 0;
}

p.ultimate-bundle-block_price_org,
p.ultimate-bundle-saving_item-price {
    color: var(--Deep-Navy, #1A2744);
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    margin: 0;
}

p.ultimate-bundle-saving_item-tag {
    margin: 0;
    border-radius: 2px;
    background: var(--Deep-Navy, #1A2744);
    padding: 0 12px;
    color: #FFF;
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    display: flex;
    align-items: center;
    justify-content: center;
}

p.ultimate-bundle_bottom_price_compare {
    color: var(--Deep-Navy, #1A2744);
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-decoration-line: line-through;
    margin: 0;
}

p.ultimate-bundle_bottom_price_org {
    color: var(--Deep-Navy, #1A2744);
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
    margin: 0;
}

h4.ultimate-bundle_bottom-title {
    color: var(--Deep-Navy, #1A2744);
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
    margin: 0;
}

.ultimate-bundle-devider {
    display: block !important;
    height: 1px;
    background: #E1E1E1;
    width: 100%;
}

.ultimate-bundle_bottom-btn .product-form__submit {
    border-radius: 4px;
    background: var(--Deep-Navy, #1A2744);
    padding: 8px 24px;
    height: 54px;
    color: #FFFFFC;
    text-align: center;
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height: 20px;
    text-transform: uppercase;
    transition : all 0.3s ease;
}

.ultimate-bundle_bottom-btn .product-form__submit:hover{
  transform: translatey(-3px);
}

.ultimate-bundle_bottom-btn .product-form__submit:before,
.ultimate-bundle_bottom-btn .product-form__submit:after {
  display: none;
}

@media screen and (max-width: 768px) {

.section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
}

.ultimate-bundle-wrapper {
    align-items: start;
    gap: 24px;
    flex-direction: column-reverse;
}

.ultimate--bundle-image {
    max-width: 100%;
}

.unltimate-bundle-content {
    max-width: 100%;
    gap: 24px;
}

.section-{{ section.id }} .ultimate-bundle-title {
    font-size: 32px;
}

.ultimate-bundle-include, 
.ultimate-bundle-saving {
    gap: 24px;
}

h4.ultimate-bundle-include_tite {
    font-family: "DM Sans";
    font-size: 14px;
    letter-spacing: 1.12px;
    font-weight: 400;
}

ul.ultimate-bundle-blocks, 
ul.ultimate-bundle-saving_items {
    gap: 16px;
}

p.ultimate-bundle-saving_item-tag {
    padding: 0 4px;
}

.ultimate-bundle_bottom-btn .product-form__submit {
    height: 44px;
}

ul.ultimate-bundle_bottom-fetures {
    gap: 12px;
}

li.ultimate-bundle_bottom-feture {
    gap: 5px;
}

}

{% endstyle %}

<section class="ultimate-bundle-section section-{{ section.id }} scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="ultimate-bundle-wrapper">
      <div class="ultimate--bundle-image">
        {% if display_image != blank %}
          {{
            display_image
            | image_url: width: 1600
            | image_tag:
              widths: '50,100,150,200,300,400,500,600,800,1000,1200,1400,1600',
              loading: 'lazy',
              alt: display_title
          }}
        {% endif %}
      </div>

      <div class="unltimate-bundle-content">
        <div class="ultimate-bundle-head">
          {% if section.settings.review_icon != blank or section.settings.review_text != blank %}
            <div class="ultimate-bundle-review">
              {% if section.settings.review_icon != blank %}
                <div class="ultimate-bundle-review-icon">
                  {{
                    section.settings.review_icon
                    | image_url: width: 200
                    | image_tag: widths: '50,100,150,200', loading: 'lazy', alt: 'review icon'
                  }}
                </div>
              {% endif %}

              {% if section.settings.review_text != blank %}
                <p class="ultimate-bundle-review-text">
                  {{ section.settings.review_text }}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if display_title != blank %}
            <h2 class="ultimate-bundle-title">
              {{ display_title }}
            </h2>
          {% endif %}
        </div>

        {% if section.settings.include_title != blank %}
          <div class="ultimate-bundle-include">
            <h4 class="ultimate-bundle-include_tite">
              {{ section.settings.include_title }}
            </h4>

            <ul class="ultimate-bundle-blocks">
              {% for block in section.blocks %}
                {% if block.type == 'include' %}
                  <li class="ultimate-bundle-block" {{ block.shopify_attributes }}>
                    {% if block.settings.title != blank %}
                      <h3 class="ultimate-bundle-block_title">
                        {{ block.settings.title }}
                      </h3>
                    {% endif %}

                    {% if block.settings.compare_price != blank or block.settings.price != blank %}
                      <div class="ultimate-bundle-block_prices">
                        {% if block.settings.compare_price != blank %}
                          <p class="ultimate-bundle-block_price_compare">
                            {{ block.settings.compare_price }}
                          </p>
                        {% endif %}

                        {% if block.settings.price != blank %}
                          <p class="ultimate-bundle-block_price_org">
                            {{ block.settings.price }}
                          </p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div class="ultimate-bundle-devider"></div>

        <div class="ultimate-bundle-saving">
          {% if section.settings.saving_title != blank %}
            <h4 class="ultimate-bundle-saving_title">
              {{ section.settings.saving_title }}
            </h4>
          {% endif %}

          <ul class="ultimate-bundle-saving_items">
            <li class="ultimate-bundle-saving_item">
              {% if section.settings.saving_text != blank %}
                <p class="ultimate-bundle-saving_item-text">
                  {{ section.settings.saving_text }}
                </p>
              {% endif %}

              {% if section.settings.saving_tag != blank %}
                <p class="ultimate-bundle-saving_item-tag">
                  {{ section.settings.saving_tag }}
                </p>
              {% endif %}
            </li>

            <li class="ultimate-bundle-saving_item">
              {% if section.settings.total_text != blank %}
                <p class="ultimate-bundle-saving_item-text">
                  {{ section.settings.total_text }}
                </p>
              {% endif %}

              {% if section.settings.total_price != blank %}
                <p class="ultimate-bundle-saving_item-price">
                  -{{ savings }}
                </p>
              {% endif %}
            </li>
          </ul>
        </div>

        <div class="ultimate-bundle-devider"></div>

        <div class="ultimate-bundle_bottom">
          <div class="ultimate-bundle_bottom-info">
            {% if section.settings.bottom_title != blank %}
              <h4 class="ultimate-bundle_bottom-title">
                {{ section.settings.bottom_title }}
              </h4>
            {% endif %}

            <div class="ultimate-bundle_bottom-prices">
              {% if compare_price != blank %}
                <p class="ultimate-bundle_bottom_price_compare">
                   {{ compare_price | money_without_trailing_zeros }}
                </p>
              {% endif %}

              {% if price != blank %}
                <p class="ultimate-bundle_bottom_price_org">
                   {{ price | money_without_trailing_zeros }}
                </p>
              {% endif %}
            </div>
          </div>

          {% if selected_product != blank %}
            <div class="ultimate-bundle_bottom-btn">
                {%- render 'buy-buttons',
                  block: section,
                  product: selected_product,
                  product_form_id: product_form_id,
                  section_id: section.id
                -%}
            </div>
          {% endif %}

          <ul class="ultimate-bundle_bottom-fetures">
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <li class="ultimate-bundle_bottom-feture" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <div class="ultimate-bundle_bottom-feture_icon">
                      {{
                        block.settings.icon
                        | image_url: width: 200
                        | image_tag: widths: '50,100,150,200', loading: 'lazy', alt: 'feature icon'
                      }}
                    </div>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <p class="ultimate-bundle_bottom-feture_text">
                      {{ block.settings.text }}
                    </p>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ultimate Bundle",
  "tag": "section",
  "class": "ultimate-bundle-section",
  "settings": [
    {
      "type": "header",
      "content": "Product Settings"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom Product Image Override"
    },
    {
      "type": "richtext",
      "id": "custom_title",
      "label": "Custom Product Title Override"
    },

    {
      "type": "header",
      "content": "Review Content"
    },
    {
      "type": "image_picker",
      "id": "review_icon",
      "label": "Review Icon"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text",
      "default": "4.9/5 Based On 10,000+ Reviews"
    },

    {
      "type": "header",
      "content": "Include Section"
    },
    {
      "type": "text",
      "id": "include_title",
      "label": "Include Title",
      "default": "What's Included"
    },

    {
      "type": "header",
      "content": "Savings Section"
    },
    {
      "type": "text",
      "id": "saving_title",
      "label": "Savings Title",
      "default": "Bundle Savings"
    },
    {
      "type": "text",
      "id": "saving_text",
      "label": "Savings Text",
      "default": "You Save"
    },
    {
      "type": "text",
      "id": "saving_tag",
      "label": "Savings Tag",
      "default": "25% OFF"
    },
    {
      "type": "text",
      "id": "total_text",
      "label": "Total Label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "total_price",
      "label": "Savings Price",
      "default": "$38",
      "info": "add saving price if product have now compare price without (-) sign"
    },

    {
      "type": "header",
      "content": "Bottom Content"
    },
    {
      "type": "text",
      "id": "bottom_title",
      "label": "Bottom Title",
      "default": "Ultimate Bundle"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card Background",
      "default": "#f7f7f7"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],

  "blocks": [
    {
      "type": "include",
      "name": "Include Item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],

  "max_blocks": 20,

  "presets": [
    {
      "name": "Ultimate Bundle",
      "category": "Custom",
      "blocks": [
        {
          "type": "include"
        },
        {
          "type": "include"
        },
        {
          "type": "include"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
