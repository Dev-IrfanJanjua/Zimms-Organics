{% style %}
.section-{{ section.id }} {
  background-color: {{ section.settings.section_bg_color }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .vision-wrapper {
  position: relative;
}

.section-{{ section.id }} .vision-head {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: space-between;
    margin-bottom: 40px;
}

.section-{{ section.id }} .vision-title {
  color: {{ section.settings.heading_color }};
  min-width: fit-content;
}

.section-{{ section.id }} .vision-subtitle {
    color: {{ section.settings.text_color }};
    margin: 0;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    max-width: 916px;
    width: 100%;
}

.section-{{ section.id }} .vision-image {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    overflow: hidden;

}

.section-{{ section.id }} .vision-image img {
  width: 100%;
  height: 100%;
  display: block;
}

.section-{{ section.id }} .vision-mobile-image {
  display: none;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .vision-head {
    margin-bottom: 24px;
    flex-direction: column;
  }

  .section-{{ section.id }} .vision-subtitle {
        font-size: 14px;;
        line-height: 20px;
        max-width: 100%;
        text-align: center;
    }

  .section-{{ section.id }} .vision-desktop-image {
    display: none;
  }

  .section-{{ section.id }} .vision-mobile-image {
    display: block;
  }
}
{% endstyle %}

<section class="vision-section section-{{ section.id }}">
  <div class="page-width">
    <div class="vision-wrapper">

      {% if section.settings.heading != blank or section.settings.subtitle != blank %}
        <div class="vision-head">

          {% if section.settings.heading != blank %}
            <h2 class="vision-title title_title">
              {{ section.settings.heading
                | replace: '<p>', ''
                | replace: '</p>', ''
              }}
            </h2>
          {% endif %}

          {% if section.settings.subtitle != blank %}
            <p class="vision-subtitle">
              {{ section.settings.subtitle }}
            </p>
          {% endif %}

        </div>
      {% endif %}

      <div class="vision-image">

        {% if section.settings.desktop_image != blank %}
          <div class="vision-desktop-image">
            {{
              section.settings.desktop_image
              | image_url: width: 1600
              | image_tag:
                widths: '50,100,150,200,300,400,500,600,800,1000,1200,1400,1600',
                loading: 'lazy',
                alt: 'image'
            }}
          </div>
        {% endif %}

        {% if section.settings.mobile_image != blank %}
          <div class="vision-mobile-image">
            {{
              section.settings.mobile_image
              | image_url: width: 1000
              | image_tag:
                widths: '50,100,150,200,300,400,500,600,800,1000',
                loading: 'lazy',
                alt: 'image'
            }}
          </div>
        {% endif %}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vision Section",
  "tag": "section",
  "class": "vision-section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtitle Color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Vision Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}