{% style %}
.section-{{ section.id }} {
  background-color: {{ section.settings.section_bg_color }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .about-img-text-wrapper {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 22px;
}

.section-{{ section.id }} .ait-content {
    flex: 1;
    max-width: 50%;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
}

.section-{{ section.id }} .ait-title {
  color: {{ section.settings.heading_color }};
  margin: 0;
}

.section-{{ section.id }} .ait-subtitle {
    color: {{ section.settings.text_color }};
    margin: 24px 0 0;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
}

.section-{{ section.id }} .ait-blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 22px;
}

.section-{{ section.id }} .ait-block-item {
    background: {{ section.settings.card_bg_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
}

.section-{{ section.id }} .ait-block-title {
    color: {{ section.settings.card_heading_color }};
    margin: 0 0 4px;
    text-align: center;
    font-family: "DM Sans";
    font-size: 32px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
}

.section-{{ section.id }} .ait-block-subtitle {
    color: {{ section.settings.text_color }};
    margin: 0;
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    text-transform: capitalize;
}

.section-{{ section.id }} .ait-image {
  flex: 1;
  height: 476px;
}

.section-{{ section.id }} .ait-image video,
.section-{{ section.id }} .ait-image img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 8px;
  object-fit: cover;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .about-img-text-wrapper {
    flex-direction: column;
    gap: 24px;
  }

  .section-{{ section.id }} .ait-content,
  .section-{{ section.id }} .ait-image {
    max-width: 100%;
    width: 100%;
  }

  .section-{{ section.id }} .ait-image{
    aspect-ratio: 1.2;
  }

    .section-{{ section.id }} .ait-title {
        text-align: center;
    }

    .section-{{ section.id }} .ait-subtitle {
        font-size: 14px;
        line-height: 20px;
        text-align: center;
    }

    .section-{{ section.id }} .ait-blocks {
        gap: 0;
        padding-bottom: 21px;
    }

    .section-{{ section.id }} .ait-block-title {
        font-size: 22px;
    }

    .section-{{ section.id }} .ait-block-subtitle {
        font-size: 12px;
        line-height: normal;
    }

    .section-{{ section.id }} .ait-block-item {
        flex: 1;
    }

}
{% endstyle %}

<section class="about-img-text-section section-{{ section.id }} scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="about-img-text-wrapper">
      
      <div class="ait-content">

        {% if section.settings.heading != blank or section.settings.subheading != blank %}
          <div class="ait-head">

            {% if section.settings.heading != blank %}
              <h2 class="ait-title title_title">
                {{ section.settings.heading
                  | replace: '<p>', ''
                  | replace: '</p>', ''
                }}
              </h2>
            {% endif %}

            {% if section.settings.subheading != blank %}
              <p class="ait-subtitle">
                {{ section.settings.subheading }}
              </p>
            {% endif %}

          </div>
        {% endif %}

        {% assign block_count = section.blocks.size %}

        {% if block_count > 0 %}
          <ul class="ait-blocks">
            {% for block in section.blocks %}
              <li class="ait-block-item scroll-trigger animate--slide-in" {{ block.shopify_attributes }}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
                >
                
                {% if block.settings.title != blank %}
                  <h3 class="ait-block-title" data-count="{{ block.settings.title }}">
                    0
                  </h3>
                {% endif %}

                {% if block.settings.content != blank %}
                  <p class="ait-block-subtitle">
                    {{ block.settings.content }}
                  </p>
                {% endif %}

              </li>
            {% endfor %}
          </ul>
        {% endif %}

      </div>

      {% assign video_poster = section.settings.video | img_url: ""   %}
      {% if section.settings.video != blank %}
        <div class="ait-image">
            {{ section.settings.video 
                | video_tag: class: 'ait_video_video', 
                controls: false, 
                muted: true,
                autoplay: true,
                loop: true,
                playsinline: true,
                poster: video_poster
                }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', initAitCounters);
document.addEventListener('shopify:section:load', initAitCounters);

function initAitCounters() {
  const counters = document.querySelectorAll(
    '.section-{{ section.id }} .ait-block-title[data-count]'
  );

  if (!counters.length) return;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const counter = entry.target;

        if (counter.dataset.animated === 'true') return;

        counter.dataset.animated = 'true';

        const original = counter.dataset.count.trim();

        const match = original.match(/^([^0-9]*)([\d,.]+)(.*)$/);

        if (!match) {
          counter.textContent = original;
          return;
        }

        const prefix = match[1];
        const numericPart = match[2];
        const suffix = match[3];

        const target = parseFloat(
          numericPart.replace(/,/g, '')
        );

        if (isNaN(target)) {
          counter.textContent = original;
          return;
        }

        const duration = 2500;
        const startTime = performance.now();

        function easeOutCubic(t) {
          return 1 - Math.pow(1 - t, 3);
        }

        function animate(currentTime) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);

          const easedProgress = easeOutCubic(progress);

          const currentValue = target * easedProgress;

          counter.textContent =
            prefix +
            Math.round(currentValue).toLocaleString() +
            suffix;

          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            counter.textContent = original;
          }
        }

        requestAnimationFrame(animate);

        observer.unobserve(counter);
      });
    },
    {
      threshold: 0.3
    }
  );

  counters.forEach((counter) => {
    observer.observe(counter);
  });
}
</script>

{% schema %}
{
  "name": "About Image Text",
  "tag": "section",
  "class": "about-image-text",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card Heading Color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block Title"
        },
        {
          "type": "text",
          "id": "content",
          "label": "Block Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Image Text",
      "category": "Custom",
      "blocks": [
        {
          "type": "content_block"
        },
        {
          "type": "content_block"
        },
        {
          "type": "content_block"
        }
      ]
    }
  ]
}
{% endschema %}