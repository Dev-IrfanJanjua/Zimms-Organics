<script>
document.addEventListener('DOMContentLoaded', function () {

  // =========================
  // SWIPER INIT
  // =========================
  var swiper = new Swiper('.myreviewsSwiper', {
    speed: 1000,
    loop: true,
    centeredSlides: true,
    slidesPerView: 4.5,
    spaceBetween: 16,

    watchOverflow: true,
    observer: true,
    observeParents: true,
    resizeObserver: true,

    breakpoints: {
      0: {
        slidesPerView: 1.3,
        spaceBetween: 12,
        centeredSlides: false,
      },
      768: {
        slidesPerView: 3,
        spaceBetween: 16,
        centeredSlides: false,
      },
      1080: {
        slidesPerView: 4.5,
        spaceBetween: 16,
        centeredSlides: true,
      }
    }
  });


  // =========================
  // FUNCTION: PAUSE ALL VIDEOS
  // =========================
  function pauseAllVideosExcept(currentVideo) {
    document.querySelectorAll(".video-only-wrapper video").forEach(video => {
      if (video !== currentVideo) {
        video.pause();

        const btn = video.closest(".video-only-wrapper")?.querySelector(".video-only-play-btn");
        if (btn) btn.style.display = "block";
      }
    });
  }


  // =========================
  // CLICK HANDLER
  // =========================
  document.addEventListener("click", function(e) {

    const wrapper = e.target.closest(".video-only-wrapper");
    if (!wrapper) return;

    const video = wrapper.querySelector("video");
    const playBtn = wrapper.querySelector(".video-only-play-btn");
    if (!video || !playBtn) return;

    // ONLY respond to video or play button click
    if (e.target === video || e.target.closest(".video-only-play-btn")) {

      // 🔥 pause others first
      pauseAllVideosExcept(video);

      // toggle current video
      if (video.paused) {
        video.play();
        playBtn.style.display = "none";
      } else {
        video.pause();
        playBtn.style.display = "block";
      }
    }
  });

  swiper.on('slideChange', function () {
    document.querySelectorAll(".video-only-wrapper video").forEach(video => {
      video.pause();

      const btn = video.closest(".video-only-wrapper")?.querySelector(".video-only-play-btn");
      if (btn) btn.style.display = "block";
    });
  });

});
</script>



