<section class="section-{{ section.id }}-padding color-scheme-{{ section.id }} happy-reviews pdp-section scroll-trigger animate--slide-in">
  <div class="page-widthr">
    <div class="csp-sec">
    <div class="main-wrapper-happy-reviews">
      <div class="csp-csng">
      <div class="main-star-svg-total csp-img">
        <img
          class="star-image"
          src="{{ section.settings.star-image | img_url: 'master' }}"
          loading="lazy"
          alt="Payment methods"
          width="100%"
          height="100%"
        >
      </div>
      <h2 class="live-heading csp-img">{{ section.settings['reviews-title'] }}</h2>
      </div>
      <div class="main-reviews-swipper  testi-grid">
        <div class="swiper myreviewsSwiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}

                {% if block.type == 'review_blocks' %}
                <div class="swiper-slide csp"
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                >
                    <div class="cs_conti csp-img">

                    <img
                        class="star-svg-block"
                        src="{{ block.settings.star-svg-block | img_url: 'master' }}"
                        loading="lazy"
                        alt=""
                        role="presentation"
                        width="100%"
                        height="100%"
                    >

                    <div class="title-desc">
                        {{ block.settings['title-desc'] }}
                    </div>

                    <div class="reviewers-name">
                        {{ block.settings['reviewers-name'] }}
                    </div>

                    <div class="varified-info">
                        <img
                        class="varified-svg"
                        src="{{ block.settings.varified-svg | img_url: 'master' }}"
                        loading="lazy"
                        alt="verified"
                        width="100%"
                        height="100%"
                        >
                        <div class="varified-heading">
                        {{ block.settings['varified-heading'] }}
                        </div>
                    </div>

                    </div>
                </div>
                {% endif %}


                {% if block.type == 'video_only' %}
                {% if block.settings.cs_video != blank %}
                    <div class="swiper-slide">
                    <div class="video-only-wrapper"
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    >
                        {% assign video_poster = block.settings.cs_video.preview_image | img_url: 'master' %}
                        {{
                        block.settings.cs_video
                        | video_tag: class: 'custom-video-slider', controls: false, muted: false, poster: video_poster
                        }}
                        <div class="video-only-play-btn">
                            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="28" cy="28" r="28" fill="white"/>
                                <path d="M35.6996 28C35.7001 28.1867 35.6522 28.3704 35.5606 28.5331C35.4691 28.6959 35.3369 28.8322 35.1771 28.9288L25.2716 34.9884C25.1046 35.0907 24.9133 35.1465 24.7175 35.1501C24.5217 35.1537 24.3285 35.105 24.1579 35.009C23.9888 34.9145 23.848 34.7767 23.7499 34.6097C23.6518 34.4427 23.5999 34.2526 23.5996 34.0589V21.941C23.5999 21.7473 23.6518 21.5572 23.7499 21.3902C23.848 21.2233 23.9888 21.0854 24.1579 20.9909C24.3285 20.8949 24.5217 20.8462 24.7175 20.8498C24.9133 20.8534 25.1046 20.9093 25.2716 21.0115L35.1771 27.0711C35.3369 27.1677 35.4691 27.304 35.5606 27.4668C35.6522 27.6295 35.7001 27.8132 35.6996 28Z" fill="#1A2744"/>
                            </svg>
                        </div>
                    </div>
                    </div>
                {% endif %}
                {% endif %}

            {% endfor %}
            </div>
          
        </div>


      </div>
    </div>
    </div>
  </div>
</section>

