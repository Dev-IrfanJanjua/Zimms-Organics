{% style %}
.section-{{ section.id }} {
  background-color: {{ section.settings.section_bg_color }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .article-banner-wrapper {
    display: grid;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    grid-template-columns: repeat(2, 1fr);
}

.section-{{ section.id }} .article-banner-content {
  flex: 1;
  max-width: 550px;
}

.section-{{ section.id }} .article-banner-title {
  color: {{ section.settings.heading_color }};
}

.section-{{ section.id }} .article-banner-date {
    color: {{ section.settings.date_color }};
    margin: 40px 0 0;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px;
}

.section-{{ section.id }} .article-banner-image {
    aspect-ratio: 1/ 0.7;
}

.section-{{ section.id }} .article-banner-image img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: {{ section.settings.image_radius }}px;
  object-fit: cover;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .article-banner-wrapper {
    grid-template-columns: 1fr;
  }

  .section-{{ section.id }} .article-banner-content,
  .section-{{ section.id }} .article-banner-image {
    width: 100%;
    max-width: 100%;
  }

  .section-{{ section.id }} .article-banner-image {
        order: -1;
        aspect-ratio: 1/ 0.9;
    }

}
{% endstyle %}

<section class="article-banner-section section-{{ section.id }}">
  <div class="page-width">
    <div class="article-banner-wrapper">

      <div class="article-banner-content">

        {% if article.title != blank %}
          <h1 class="article-banner-title title_title">
            {{ article.title }}
          </h1>
        {% endif %}

        <p class="article-banner-date">
          {{ article.published_at | date: "%B %-d, %Y" }}
        </p>

      </div>

      {% if article.image %}
        <div class="article-banner-image">
          {{
            article.image
            | image_url: width: 1600
            | image_tag:
              widths: '400,600,800,1000,1200,1400,1600',
              loading: 'eager',
              alt: article.title
          }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Article Details Banner",
  "tag": "section",
  "class": "article-details-banner",
  "settings": [
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#F3F2ED"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title Color",
      "default": "#24345D"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date Color",
      "default": "#4A5670"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Article Details Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}