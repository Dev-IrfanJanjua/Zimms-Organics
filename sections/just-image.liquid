{% style %}
.section-{{ section.id }} {
  background-color: {{ section.settings.section_bg_color }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .custom-image-wrapper {
  width: 100%;
}

.section-{{ section.id }} .custom-image-wrapper img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 8px;
}

.section-{{ section.id }} .custom-image-mobile {
  display: none;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .custom-image-desktop {
    display: none;
  }

  .section-{{ section.id }} .custom-image-mobile {
    display: block;
  }
}
{% endstyle %}

<section class="custom-image-section section-{{ section.id }}">
  <div class="page-width">
    <div class="custom-image-wrapper">

      {% if section.settings.desktop_image != blank %}
        <div class="custom-image-desktop">
          {{
            section.settings.desktop_image
            | image_url: width: 2000
            | image_tag:
              widths: '200,400,600,800,1000,1200,1400,1600,1800,2000',
              loading: 'lazy',
              alt: section.settings.image_alt
          }}
        </div>
      {% endif %}

      {% if section.settings.mobile_image != blank %}
        <div class="custom-image-mobile">
          {{
            section.settings.mobile_image
            | image_url: width: 1000
            | image_tag:
              widths: '200,400,600,800,1000',
              loading: 'lazy',
              alt: section.settings.image_alt
          }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Image",
  "tag": "section",
  "class": "custom-image-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Image"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Image",
      "category": "Custom"
    }
  ]
}
{% endschema %}