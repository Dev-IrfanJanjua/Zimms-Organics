          "type": "button"
        },
        "f7aa8fa8-6f62-4b2b-aed2-7cd812eac707": {
          "settings": {
            "heading": "HOW DAVID HEALED FROM CROHNS DISEASE NATURALLY WITH THE HELP OF OLIVE OIL",
