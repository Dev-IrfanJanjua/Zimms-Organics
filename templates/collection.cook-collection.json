        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Cook contains a medium-high range polyphenol 100% Arbosana olive from Central California.<br/><br/><strong>Uses</strong> - This olive oil works well with heat. Cook any of your favorite foods in a pan, oven or even an open flame, and let the olive oil naturally bring out the best flavors of your food.<br/></p><ul><li><strong>Single Origin</strong> - Central California</li><li><strong>Single Varietal</strong> - 100% Arbosana Olives</li><li><strong>Flavor Profile</strong> - Grassy, nutty, robust and well balanced.</li></ul>",
            "text_style": "body"
          }
        },
