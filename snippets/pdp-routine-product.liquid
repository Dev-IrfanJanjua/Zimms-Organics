<script>
document.addEventListener('DOMContentLoaded', function () {

  // ─── Sync checked variant IDs onto the Add-to-Cart button ──────────────────

  function syncSection(section) {
    const addBtn = section.querySelector('.routine-product-form__submit');
    if (!addBtn) return;

    const checkedInputs = section.querySelectorAll('.pdp-routine-product_input:checked');
    const ids = Array.from(checkedInputs).map(input => input.dataset.variantId);
    addBtn.setAttribute('data-selected-variant-ids', ids.join(','));
  }

  // Initial sync for every routine block on the page
  document.querySelectorAll('.pdp-routine-products').forEach(syncSection);

  // Keep in sync whenever a checkbox changes
  document.addEventListener('change', function (event) {
    const checkbox = event.target.closest('.pdp-routine-product_input');
    if (!checkbox) return;
    const section = checkbox.closest('.pdp-routine-products');
    if (section) syncSection(section);
  });

  // ─── Re-fetch & patch the cart drawer exactly as the theme does ────────────
  // This mirrors CartItems.onCartUpdate() for the 'CART-DRAWER-ITEMS' branch.
  // The theme fetches ?section_id=cart-drawer and replaces two selectors:
  //   • cart-drawer-items   → the line-items list
  //   • .cart-drawer__footer → subtotal / checkout button

  function refreshCartDrawer() {
    return fetch(`${routes.cart_url}?section_id=cart-drawer`)
      .then(response => response.text())
      .then(responseText => {
        const html = new DOMParser().parseFromString(responseText, 'text/html');
        const selectors = ['cart-drawer-items', '.cart-drawer__footer'];

        for (const selector of selectors) {
          const target = document.querySelector(selector);
          const source = html.querySelector(selector);
          if (target && source) {
            target.replaceWith(source);
          }
        }
      });
  }

  // ─── Update the cart icon bubble (count badge) ─────────────────────────────

  function refreshCartBubble(sectionsData) {
    if (!sectionsData?.['cart-icon-bubble']) return;

    const doc = new DOMParser().parseFromString(sectionsData['cart-icon-bubble'], 'text/html');
    const newBubble      = doc.querySelector('.shopify-section');
    const existingBubble = document.querySelector('#cart-icon-bubble');

    if (newBubble && existingBubble) {
      existingBubble.innerHTML = newBubble.innerHTML;
    }
  }

  // ─── Open the cart drawer ──────────────────────────────────────────────────

  function openCartDrawer() {
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer && typeof cartDrawer.open === 'function') {
      cartDrawer.open();
    }
  }

  // ─── Add-to-Cart click handler ─────────────────────────────────────────────

  document.addEventListener('click', async function (event) {

    const addBtn = event.target.closest('.routine-product-form__submit');
    if (!addBtn) return;

    const routineSection = addBtn.closest('.pdp-routine-products');
    if (!routineSection) return;

    // Guard: prevent double-fire on rapid clicks
    if (addBtn.dataset.processing === 'true') return;
    addBtn.dataset.processing = 'true';

    const checkedInputs = routineSection.querySelectorAll('.pdp-routine-product_input:checked');

    if (checkedInputs.length === 0) {
      alert('Please select at least one product.');
      addBtn.dataset.processing = 'false';
      return;
    }

    const items = Array.from(checkedInputs).map(input => ({
      id: parseInt(input.dataset.variantId),
      quantity: 1
    }));

    // Guard: prevent duplicate identical concurrent request
    const payloadKey = JSON.stringify(items);
    if (window.__routineCartLock === payloadKey) return;
    window.__routineCartLock = payloadKey;

    // Visual feedback
    addBtn.disabled = true;
    const btnText = addBtn.querySelector('.btn-text');
    if (btnText) btnText.textContent = 'Adding...';

    try {

      // ── Step 1: Add items to cart, request the icon bubble section ──────────
      const addResponse = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items,
          sections: ['cart-icon-bubble']
        })
      });

      if (!addResponse.ok) {
        const err = await addResponse.json();
        throw new Error(err.description || 'Failed to add to cart');
      }

      const addData = await addResponse.json();

      // ── Step 2: Update the cart icon bubble ─────────────────────────────────
      refreshCartBubble(addData.sections);

      // ── Step 3: Re-fetch the full cart drawer section from Shopify ──────────
      // This is the same network call the theme makes in onCartUpdate().
      // It guarantees the drawer HTML is 100% fresh from Liquid — no stale state.
      await refreshCartDrawer();

      // ── Step 4: Open the drawer ─────────────────────────────────────────────
      openCartDrawer();

      window.__routineCartLock = null;

    } catch (err) {
      console.error('Routine cart error:', err);
      alert(err.message || 'Something went wrong. Please try again.');
      window.__routineCartLock = null;

    } finally {
      addBtn.disabled = false;
      addBtn.dataset.processing = 'false';
      if (btnText) btnText.textContent = 'Add to Cart';
    }

  });

});
</script>