{% style %}

/* ------------------------gallery----------------------- */
.media-gallery-grid {
  overflow: hidden;
  width: 100%;
  position: sticky;
  top: 10px;
}

.pg-thumbs {
  margin-top: 10px;
}

.pg-thumbs img {
  border-radius: 16px;
  cursor: pointer;
  width: 100%;
  height: auto;
  object-fit: cover;
  display: block;
}
.cs-prev {
  left: 18px;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  cursor: pointer;
}
.cs-next {
  right: 18px;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  cursor: pointer;
}
.pg-main img {
      width: 100%;
    border-radius: 4px;
    display: block;
}
.pg-thumbs {
  margin-top: 10px;
}

.pg-thumbs {
  margin-top: 12px;
}
.pg-thumbs img {
  border-radius: 6px;
  cursor: pointer;
  width: 100%;
  height: auto;
  object-fit: cover;
}
#pgThumbs .swiper-slide-thumb-active {
  border: 0.5px solid #00000033;
}
#pgThumbs .swiper-slide-thumb-active {
  border-radius: 6px;
  border: 0.5px solid #000;
}
.cs_herbies-back-img-main {
  position: relative;
}
.herbies-trust_back-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
img.herbies-trust_back-image {
  display: block;
  object-fit: cover;
  width: 100%;
  height: 100%;
  border-radius: 4px;
  border-radius: 10px;
  background: linear-gradient(44.72deg, #7C4527 -9.5%, #9F5933 58.07%, #7C4527 93.16%);

/* background: linear-gradient(45deg, rgba(124, 69, 39, 0.85) -9.5%, rgba(159, 89, 51, 0.85) 58.07%, rgba(124, 69, 39, 0.85) 93.16%); */
}
#pgThumbs{
    display: none;
}
.cs_main-product_img_bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 10px;
}
.cs_main-product_img_bottom_img img {
    display: block;
    object-fit: cover;
    width: 100%;
    height: auto;
    border-radius: 4px;
}

@media screen and (max-width: 768px){

.cs_main-product_img_bottom {
    display: none;
}

}

{% endstyle %}

<div>
      <div class="media-gallery-grid">
  <div class="pg-wrap">
    <div class="swiper pg-main" id="pgMain">
      <div class="swiper-wrapper">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <div class="swiper-slide">
              <img
                src="{{ media | img_url: '800x800', crop: 'center' }}"
                alt="{{ media.alt | escape | default: product.title }}"
                {% if forloop.first %}loading="eager"{% else %}loading="eager"{% endif %}
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>

     
    </div>

    <div class="swiper pg-thumbs" id="pgThumbs">
      <div class="swiper-wrapper">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <div class="swiper-slide">
              <img
                src="{{ media | img_url: '160x160', crop: 'center' }}"
                alt="{{ media.alt | escape | default: product.title }}"
                loading="eager"
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
</div>
<div class="cs_main-product_img_bottom">
  {%- for media in product.media -%}
    {%- if media.media_type == 'image' -%}
      {%- if forloop.index > 1 and forloop.index <= 5 -%}
        <div class="cs_main-product_img_bottom_img">
          <img src="{{ media | image_url }}" width="100%" height="auto" loading="eager">
        </div>
      {% endif %}
    {%- endif -%}
  {%- endfor -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 1. Thumbs Slider Pehle Initialize Karein
    var thumbs = new Swiper('#pgThumbs', {
      slidesPerView: 6,
      watchSlidesProgress: true,
      slideToClickedSlide: true,
      speed: 500,
      spaceBetween: 8, // Default mobile
      breakpoints: {
         0: {
           slidesPerView: 5.5,
          spaceBetween: 8
        },
        768: {
           slidesPerView: 6,
          spaceBetween: 12
        }
      }
    });

    // 2. Main Slider
    var main = new Swiper('#pgMain', {
  speed: 500,
  thumbs: {
    swiper: thumbs,
  },
  navigation: {
    nextEl: '.cs-next',
    prevEl: '.cs-prev',
  },

  // 1. Mobile ke liye settings (Default)
  slidesPerView: 1.05,      // 768px se niche 1.1 slides nazar aayengi
  spaceBetween: 8,         // Mobile par gap

  breakpoints: {
    // 2. Desktop ke liye settings (768px aur usse upar)
    768: {
      slidesPerView: 1,    // Desktop par poori 1 slide
      spaceBetween: 12     // Desktop par gap
    }
  }
    });
  });

  document.querySelectorAll('*').forEach(el => {
  if (el.scrollWidth > document.documentElement.clientWidth) {
    console.log(el, el.scrollWidth);
  }
});
</script>