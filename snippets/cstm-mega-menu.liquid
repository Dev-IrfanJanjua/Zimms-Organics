{% style %}

.mega-custom {
    display: flex;
    gap: 45px;
    padding: 0 76px;
}

.mega-menu-image {
    max-width: 37.5%;
    width: 100%;
    height: auto;
}

.mega-menu-image img{
    width: 100%;
    height: 100%;
    display: block;
}

.mega-products {
    display: flex;
    gap: 20px;
    max-width: calc(100% - (37.5% + 45px));
}

.header-wrapper--border-bottom .mega-menu__content {
    background: #fff;
    padding-block: 28px;
}

.mega-products .fet-col-card-title {
    font-size: 14px !important;
}

.mega-products p.fet-col-card-subtitle {
    font-size: 12px !important;
}

.mega-products .fet-col-card {
    max-width: calc(33.3% - 13.1px);
    width: 100%;
}

@media screen and (max-width: 768px){

.mega-menu-image {
    display: none;
}

.mega-custom {
    padding: 16px 0 30px !important;
}

.mega-products {
    display: flex;
    gap: 13px 9px;
    max-width: 100%;
    flex-wrap: wrap;
}

.mega-products .fet-col-card {
    max-width: calc(50% - 4.5px);
    width: 100%;
}

.mega-products .fet-col-card .fet-col-card-prices {
    display: none;
}

.mega-products .fet-col-card p.fet-col-card-subtitle {
    display: none;
}

.mega-products .fet-col-card .fet-col-card-reviews {
    display: none;
}

.mega-products .fet-col-card .fet-col-card-media {
    aspect-ratio: 1;
}

.menu-drawer__submenu {
    background: #fff !important;
    display: flex;
    flex-direction: column;
    padding-inline: 13px;
    top: 50px !important;
}

.mega-products .fet-col-card-title-icon {
    display: block !important;
    width: 18px;
    height: 18px;
}

.fet-col-card-title-icon svg {
    width: 100%;
    height: 100%;
    display: block;
}

.menu-drawer__navigation-container {
    background: #fff;
}

details {
  display: flex;
  flex-direction: column;
}

details > summary {
  cursor: pointer;
}


.menu-drawer__inner-submenu {
  display: flex;
  flex-direction: column;
  width: 100%;
}

button.menu-drawer__close-button {
    margin: 0;
    padding-inline: 0;
    gap: 10px;
    color: var(--black, #1E1E1E);
    text-align: center;
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%;
}

button.menu-drawer__close-button svg {
    transform: rotate(180deg);
}

.menu-drawer summary.menu-drawer__menu-item {
    padding: 0;
    justify-content: space-between;
}

.menu-drawer__menu-item>.icon-arrow {
    position: static;
    transform: unset;
}



}

{% endstyle %}


<div class="mega-custom">


    {% if mega_block.settings.products != blank %}
        <div class="mega-products">
            {% for product in mega_block.settings.products %}
            {% render 'collection-card', section: section, product: product %}
            {% endfor %}
        </div>
        {% if mega_block.settings.image %}
            <div class="mega-menu-image">
                {{ mega_block.settings.image | image_url: width: 1600 | image_tag:
                    widths: '50, 100, 150, 200, 250, 300, 400, 500,600,1440',
                    alt: "image",
                    loading: "lazy"
                }}
            </div>
        {% endif %}
    {% endif %}

</div>