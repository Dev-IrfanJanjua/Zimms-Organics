{% style %}

.pdp-buybundle_image {
    max-width: 105px;
    width: 100%;
    height: auto;
    flex-shrink: 0;
}

.pdp-buybundle_image img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

h3.pdp-buybundle_title {
    color: #000;
    font-family: "DM Sans";
    font-size: 23px;
    font-style: normal;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: -0.5px;
    text-transform: capitalize;
    margin: 0;
}

a.pdp-buybundle_button {
    border-radius: 4px;
    border: 1px solid #1A2744;
    padding: 10px 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    color: #1A2744;
    text-align: center;
    font-family: "DM Sans";
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 21.2px;
    letter-spacing: 0.32px;
    text-transform: capitalize;
    margin-top: 16px;
    cursor: pointer;
}

a.pdp-buybundle_button:hover{
    transform: scale(1.01);
}

.pdp-buybundle {
    padding: 20px;
    border-radius: 4px;
    background: #F3F3EC;
    display: flex;
    align-items: center;
    gap: 32px;
    margin: 32px 0 !important;
}

@media screen and (max-width: 768px){

.pdp-buybundle {
    padding: 16px 0;
    gap: 12px;
}

.pdp-buybundle_image {
    max-width: 80px;
}

h3.pdp-buybundle_title {
    font-size: 16px;
}

a.pdp-buybundle_button {
    padding: 6px 12px;
    font-size: 14px;
    margin-top: 10px;
}

}

{% endstyle %}

<div class="pdp-buybundle" {{ block.shopify_attributes }}>
    {% if block.settings.image != blank %}
        <div class="pdp-buybundle_image">
            {{ block.settings.image | image_url: width: 1600 | image_tag:
                widths: '50, 100, 150, 200, 250, 300, 400, 500,600,1440',
                alt: "image",
                loading: "lazy"
            }}
        </div>
    {% endif %}
    <div class="pdp-buybundle_content">
        {% if block.settings.title != blank %}
            <h3 class="pdp-buybundle_title">{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.btn != blank %}
            <a class="pdp-buybundle_button" href="{{ block.settings.btn_link }}">{{ block.settings.btn }}</a>
        {% endif %}
    </div>
</div>