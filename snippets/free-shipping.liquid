{% style %}

/* Progress bar */
.progress-bar-container {
  width: 100%;
  margin: auto;
}

.progress-bar {
  height: 0.13rem;
  width: 100%;
}

.progress-bar-value {
  width: 100%;
  height: 100%;
  background-color: rgb(var(--color-foreground));
  animation: indeterminateAnimation var(--duration-extra-longer) infinite ease-in-out;
  transform-origin: 0;
}

.progress-bar .progress-bar-value {
  display: block;
}

@keyframes indeterminateAnimation {
  0% {
    transform: translateX(-20%) scaleX(0);
  }
  40% {
    transform: translateX(30%) scaleX(0.7);
  }
  100% {
    transform: translateX(100%) scaleX(0);
  }
}
.progress-bar-done {
    display: flex;
    text-align: center;
    align-items: center;
    justify-content: center;
    background-color: #1A2744;
    /* background-image: repeating-linear-gradient(to left, #F9E99A, #F9E99A, #F9E99A); */
    /* box-shadow: 0 5px 5px -6px #000; */
    border-radius: 14px;
    height: 100%;
    transition: all 1s ease 0.4s;
    max-width: 100%;
    width: 66%;
}
.free_shipping_notice{
      color: var(--DARK-GREY, #333232);
      text-align: center;
      font-family: "Montserrat";
      font-size: 16px;
      font-style: normal;
      font-weight: 400;
      line-height: 22px; /* 137.5% */

}
.progress-bar {
    height: .13rem;
    width: 100%;
}
.progress-bar {
    background-color: #EBEBEB;
    display: flex;
    height: 12px;
    width: 100%;
    border-radius: 14px;
    padding: 0px;
    position: relative;
    align-items: center;
}
.shipping-message {
    margin: 4px 0 0;
    line-height: normal;
}
.upsell-container {
    margin: 7px 0 ;
}

span.free_shipping_notice.success {
    color: #000;
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: capitalize;
}


@media screen and (max-width: 768px) {
.custom-drawer .main-drawer {
    display: flex;
    flex-direction: column;
    padding: 0px;
}
.drawer-wrapper {
    display: block;
    padding:0px;
    padding-right: 0px;
}
.upsell-cart-btn {
        color: #000;
        font-family: Montserrat;
        font-size: 10px;
        font-style: normal;
        font-weight: 600;
        line-height: 10.607px; /* 106.065% */
        text-transform: uppercase;
}

    .drawer-checkout {
        color: #000;
        leading-trim: both;
        text-edge: cap;
        font-family: Montserrat;
        font-size: 16px;
        font-style: normal;
        font-weight: 600;
        line-height: 17.47px; /* 109.187% */
        text-transform: uppercase;
    }
    .custom-drawer .cart-item {
    display: grid;
    grid-template: repeat(2, auto) / repeat(4, 1fr);
    gap: 1.2rem;
}
cart-drawer-items {
    padding-left: 16px;
    overflow-y: auto;
    overflow-x: hidden;
    max-height: 200px;
    padding-right: 16px;
}
.custom-drawer .cart-items, .cart-drawer tbody {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
}
.custom-drawer .drawer__header {
    position: relative;
    padding: 20px 0 20px;
  }

}

{% endstyle %}

{% comment %} <div class="cart-drawer__progress">

{% if cart.items.size > 0 %}
    {% assign cart_total = cart.total_price | divided_by: 100 %}
    {% assign goal = settings.free_shipping_amount %}
    {% if cart_total >= goal %}
    {% assign progress = 100 %}
    {% else %}
    {% assign progress = cart_total | times: 100 | divided_by: goal %}
    {% endif %}

    <div class="upsell-container">
    <p class="shipping-message">
        {% if cart_total < goal %}
        {% assign remaining = goal | minus: cart_total %}
        <span class="free_shipping_notice">
            {{ settings.free_shipping_text | replace: '[amount]', remaining }}
        </span>
        {% else %}
        <span class="free_shipping_notice success">
            {{ settings.free_shipping_success }}
        </span>
        {% endif %}
    </p>

    <div class="progress-bar">
        <div class="progress-bar-done" style="width: {{ progress }}%;"><span></span></div>
    </div>
    </div>
{% endif %}
</div> {% endcomment %}

